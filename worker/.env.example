# Copy to .env and edit if needed
#
# API configuration
API_URL=http://localhost:8000
API_INTERVAL=30
API_RETRIES=3
API_SLEEP_ON_ERROR=5

# Kafka configuration (optional - leave KAFKA_BOOTSTRAP_SERVERS empty to disable)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=f1.events

# Fragment identification
FRAGMENT_ID=test-fragment-1
